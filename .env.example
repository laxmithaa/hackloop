# Healthcare Bill Navigator - backend configuration example.
# Copy this file to .env and adjust as needed:
#   Copy-Item .env.example .env
# Placeholder values only. Never commit real secrets.

HBN_APP_NAME=Healthcare Bill Navigator API
HBN_APP_VERSION=0.1.0
HBN_ENVIRONMENT=local
HBN_API_V1_PREFIX=/api/v1

# Comma-separated values or a JSON array. Use exact origins (no trailing slash).
HBN_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
HBN_CORS_ALLOW_CREDENTIALS=true

HBN_LOG_LEVEL=INFO
HBN_REQUEST_ID_HEADER=X-Request-ID

# --- Phase 2: sessions, consent, uploads and OCR (all in-memory, nothing written to disk) ---
# How long an anonymous session stays valid.
HBN_SESSION_TTL_MINUTES=60
# Server-side version of the consent text patients accept.
HBN_CONSENT_POLICY_VERSION=patient-consent-2026-10-v1
# Bill photo upload ceiling (MB) and max image side in pixels.
HBN_BILL_UPLOAD_MAX_SIZE_MB=5
HBN_IMAGE_MAX_DIMENSION_PX=5000
# Local, non-generative OCR (Tesseract executable must be installed separately).
HBN_OCR_ENGINE=tesseract
HBN_OCR_LANGUAGE=eng
# Only needed if tesseract.exe is neither on PATH nor in the usual install dir,
# e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
# HBN_OCR_TESSERACT_CMD=
HBN_OCR_LOW_CONFIDENCE_THRESHOLD=55

# --- Phase 3: access-code verification (all verification state stays in memory) ---
# A verification challenge is created when a bill is identified and expires
# after this many minutes. Attempts per challenge before it locks: 3.
HBN_VERIFICATION_CHALLENGE_TTL_MINUTES=5
HBN_VERIFICATION_MAX_ATTEMPTS=3
# PBKDF2-HMAC-SHA256 work factor for hashing fictional access codes.
HBN_ACCESS_CODE_PBKDF2_ITERATIONS=60000

# Local-development provisioning of fictional access codes.
# One variable per bill: HBN_BILL_ACCESS_CODE_<ALPHANUMERIC_BILL_NUMBER>=<code>
# The suffix is the bill number reduced to uppercase A-Z/0-9, e.g.
#   SUN-2026-004512  ->  HBN_BILL_ACCESS_CODE_SUN2026004512=DEMO1234
# Codes live only in .env / the environment (never commit them), are hashed to
# PBKDF2 digests at startup, and are never returned by any endpoint. A bill
# without a configured code can never be verified (fails closed, no bypass).
# Registered fictional bill numbers: SUN-2026-004512, SUN-2026-004770,
# GME-2026-001122, HBR-2026-555310.
# HBN_BILL_ACCESS_CODE_SUN2026004512=DEMO1234
# HBN_BILL_ACCESS_CODE_GME2026001122=DEMOCODE2

# --- Phase 8: local GenAI bill explanation (Ollama, localhost only) ---
# The explanation feature uses a locally running Ollama server — never a
# cloud AI provider. Install Ollama from https://ollama.com and download the
# model once:  ollama pull qwen3:1.7b
# When the server/model is not running, explanation responses automatically
# use the deterministic fallback text instead (still multilingual).
HBN_OLLAMA_BASE_URL=http://localhost:11434
HBN_OLLAMA_MODEL=qwen3:1.7b
# Per-request timeout for the local model call (seconds); slow/absent models
# degrade quickly to the deterministic fallback explanation.
HBN_OLLAMA_TIMEOUT_SECONDS=60
# Hard character ceiling for one generated explanation; longer completions
# are discarded (never truncated) in favour of the fallback text.
HBN_OLLAMA_MAX_OUTPUT_CHARS=2000

# --- Production-mode safety (HBN_ENVIRONMENT=production) ---
# Starting with environment='production' REQUIRES:
#   * SUPPORT_STAFF_API_TOKEN set to a real (non-placeholder) secret, and
#   * HBN_CORS_ORIGINS configured to the real deployment origins (the
#     localhost development defaults are rejected).
# Invalid combinations fail the process at startup with a clear, secret-free
# error instead of quietly shipping insecure defaults.

# --- Phase 4: support-worker access for the help-request workflow ---
# Token presented as the X-Support-Staff-Token header on /api/v1/staff/*
# endpoints. MUST be at least 16 characters, must NOT be a placeholder such
# as changeme/admin/token (rejected at startup), and stays out of version
# control. While unset/empty every staff endpoint answers 503 (fails closed).
# Production additionally REQUIRES this token before the process starts.
# SUPPORT_STAFF_API_TOKEN=
